{
  "name": "birdspotter",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:cbc-scout": "vite --mode cbc-scout",
    "dev:birdspotter": "vite --mode birdspotter",
    "build": "tsc -b && vite build --mode site && vite build && vite build --mode cbc-scout && vite build --mode birdspotter",
    "preview": "vite preview --mode site",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"site/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint packages apps site scripts",
    "screenshots": "npm run build && node scripts/screenshots/capture.ts",
    "labels": "node scripts/sync-labels.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.1.0"
  }
}
